# 文本文件统一用 LF 入库，检出时按 .gitattributes 规则转换
* text=auto

# Windows 脚本保留 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件：不做换行转换、不参与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary